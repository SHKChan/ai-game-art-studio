{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-game-art-studio.local/schema/character/1",
  "title": "Character master",
  "type": "object",
  "required": ["schema_version", "id", "project_id", "name", "art_style", "direction_mode", "directions", "masters", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "project_id": {"type": "string"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 4000},
    "art_style": {"enum": ["pixel", "hd"]},
    "visual_style": {"type": "string", "maxLength": 2000},
    "camera": {"enum": ["side", "top_down", "three_quarter", "isometric", "front"]},
    "direction_mode": {"enum": ["side2", "four", "eight"]},
    "directions": {"type": "array", "items": {"type": "string"}},
    "mirroring": {
      "type": "object",
      "description": "Optional horizontal mirroring; map target direction -> source direction.",
      "properties": {"enabled": {"type": "boolean"}, "pairs": {"type": "object"}}
    },
    "proportions": {"type": "object"},
    "palette": {"type": "array", "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}},
    "palette_frozen": {"type": "boolean"},
    "clothing": {"type": "array", "items": {"type": "string"}},
    "accessories": {"type": "array", "items": {"type": "string"}},
    "weapon": {"type": "object"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "negative_constraints": {"type": "array", "items": {"type": "string"}},
    "concept_art": {"type": "array", "items": {"type": "string"}},
    "masters": {
      "type": "object",
      "description": "direction (or 'primary') -> master reference record",
      "additionalProperties": {
        "type": "object",
        "required": ["file", "locked"],
        "properties": {
          "file": {"type": "string"},
          "locked": {"type": "boolean"},
          "approved_at": {"type": ["number", "null"]},
          "source_asset": {"type": ["string", "null"]},
          "is_test_fixture": {"type": "boolean"},
          "sha256": {"type": "string"}
        }
      }
    },
    "candidates": {"type": "array", "items": {"type": "object"}},
    "history": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "number"},
    "updated_at": {"type": "number"}
  }
}
