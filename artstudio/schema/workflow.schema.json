{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-game-art-studio.local/schema/comfy-workflow/1",
  "title": "ComfyUI workflow template",
  "type": "object",
  "required": ["schema", "id", "name", "category", "workflow", "inputs", "mappings", "outputs", "required_nodes", "required_models", "verification"],
  "properties": {
    "schema": {"const": "artstudio.comfy-workflow/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "category": {"enum": ["text_to_image", "image_to_image", "character_reference", "pose_keyframe", "inpainting", "image_to_video", "background_removal"]},
    "verification": {"enum": ["unverified", "mock-tested", "production-verified"]},
    "workflow": {"type": "object"},
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"enum": ["string", "text", "int", "float", "seed", "image", "mask", "model", "bool"]},
          "required": {"type": "boolean"},
          "description": {"type": "string"},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "model_folder": {"type": "string"}
        }
      }
    },
    "mappings": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["node", "input"],
          "properties": {"node": {"type": "string"}, "input": {"type": "string"}}
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["node"], "properties": {"node": {"type": "string"}, "kind": {"enum": ["image", "video", "gif", "mask"]}}}
    },
    "required_nodes": {"type": "array", "items": {"type": "string"}},
    "required_models": {
      "type": "array",
      "items": {"type": "object", "required": ["node", "input"], "properties": {"node": {"type": "string"}, "input": {"type": "string"}, "param": {"type": "string"}}}
    },
    "notes": {"type": "string"}
  }
}
