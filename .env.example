# Copy to .env (or set in your shell / start script). Nothing secret is required.
ARTSTUDIO_WORKSPACE=D:\GameArt\studio-workspace
ARTSTUDIO_PORT=8870
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=600
