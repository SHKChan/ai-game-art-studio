{
  "schema": "artstudio.comfy-workflow/1",
  "id": "sd-pose-keyframe",
  "name": "Pose-controlled keyframe (ControlNet, core nodes)",
  "category": "pose_keyframe",
  "verification": "unverified",
  "description": "Keyframe for one animation pose: character reference (img2img) + pose control image.",
  "workflow": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "SET_CHECKPOINT_PARAMETER"
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "4",
          1
        ]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "4",
          1
        ]
      }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 28,
        "cfg": 6.5,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 0.55,
        "model": [
          "4",
          0
        ],
        "positive": [
          "14",
          0
        ],
        "negative": [
          "14",
          1
        ],
        "latent_image": [
          "11",
          0
        ]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "3",
          0
        ],
        "vae": [
          "4",
          2
        ]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "artstudio",
        "images": [
          "8",
          0
        ]
      }
    },
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "reference.png"
      }
    },
    "11": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "10",
          0
        ],
        "vae": [
          "4",
          2
        ]
      }
    },
    "12": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "pose.png"
      }
    },
    "13": {
      "class_type": "ControlNetLoader",
      "inputs": {
        "control_net_name": "SET_CONTROLNET_PARAMETER"
      }
    },
    "14": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": [
          "6",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "control_net": [
          "13",
          0
        ],
        "image": [
          "12",
          0
        ],
        "strength": 0.9,
        "start_percent": 0.0,
        "end_percent": 0.85
      }
    }
  },
  "inputs": {
    "checkpoint": {
      "type": "model",
      "required": true,
      "model_folder": "checkpoints",
      "description": "Checkpoint filename on YOUR server (see /object_info CheckpointLoaderSimple)."
    },
    "prompt": {
      "type": "text",
      "required": true,
      "description": "Positive prompt (built from the locked character master)."
    },
    "negative_prompt": {
      "type": "text",
      "required": false
    },
    "seed": {
      "type": "seed",
      "required": false,
      "description": "-1 = random"
    },
    "steps": {
      "type": "int",
      "required": false,
      "minimum": 1,
      "maximum": 200
    },
    "cfg": {
      "type": "float",
      "required": false,
      "minimum": 0,
      "maximum": 30
    },
    "sampler_name": {
      "type": "string",
      "required": false
    },
    "scheduler": {
      "type": "string",
      "required": false
    },
    "reference_image": {
      "type": "image",
      "required": true
    },
    "denoise": {
      "type": "float",
      "required": false,
      "minimum": 0,
      "maximum": 1
    },
    "pose_image": {
      "type": "image",
      "required": true,
      "description": "Pose/control image (e.g. OpenPose skeleton)"
    },
    "controlnet": {
      "type": "model",
      "required": true,
      "model_folder": "controlnet"
    },
    "control_strength": {
      "type": "float",
      "required": false,
      "minimum": 0,
      "maximum": 2
    }
  },
  "mappings": {
    "checkpoint": [
      {
        "node": "4",
        "input": "ckpt_name"
      }
    ],
    "prompt": [
      {
        "node": "6",
        "input": "text"
      }
    ],
    "negative_prompt": [
      {
        "node": "7",
        "input": "text"
      }
    ],
    "seed": [
      {
        "node": "3",
        "input": "seed"
      }
    ],
    "steps": [
      {
        "node": "3",
        "input": "steps"
      }
    ],
    "cfg": [
      {
        "node": "3",
        "input": "cfg"
      }
    ],
    "sampler_name": [
      {
        "node": "3",
        "input": "sampler_name"
      }
    ],
    "scheduler": [
      {
        "node": "3",
        "input": "scheduler"
      }
    ],
    "reference_image": [
      {
        "node": "10",
        "input": "image"
      }
    ],
    "denoise": [
      {
        "node": "3",
        "input": "denoise"
      }
    ],
    "pose_image": [
      {
        "node": "12",
        "input": "image"
      }
    ],
    "controlnet": [
      {
        "node": "13",
        "input": "control_net_name"
      }
    ],
    "control_strength": [
      {
        "node": "14",
        "input": "strength"
      }
    ]
  },
  "outputs": [
    {
      "node": "9",
      "kind": "image"
    }
  ],
  "required_nodes": [
    "CLIPTextEncode",
    "CheckpointLoaderSimple",
    "ControlNetApplyAdvanced",
    "ControlNetLoader",
    "KSampler",
    "LoadImage",
    "SaveImage",
    "VAEDecode",
    "VAEEncode"
  ],
  "required_models": [
    {
      "node": "4",
      "input": "ckpt_name",
      "param": "checkpoint"
    },
    {
      "node": "13",
      "input": "control_net_name",
      "param": "controlnet"
    }
  ],
  "notes": ""
}
